# ─────────────────────────────────────────────────────────────────────────────
# Email settings (server-side only).
# Set these in Vercel → your project → Settings → Environment Variables.
# Never prefix them with VITE_ — that would ship them to the browser.
# For local `npx vercel dev`, copy this file to .env.local (git-ignored).
# See EMAIL_SETUP.md for details.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin key: Firebase Console → Project settings → Service accounts →
# "Generate new private key". Paste the whole JSON (or its base64) as the value.
FIREBASE_SERVICE_ACCOUNT=

# cPanel SMTP: cPanel → Email Accounts → your mailbox → "Connect Devices".
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
# ssl (port 465) | starttls (port 587) | none
SMTP_ENCRYPTION=ssl
SMTP_USER=info@yourdomain.com
SMTP_PASS=

MAIL_FROM_NAME=DIGISPIRE
MAIL_FROM_ADDRESS=info@yourdomain.com
# Optional: where student replies go (defaults to the from-address)
MAIL_REPLY_TO=
# Copied (CC) on emails sent from the app when the "CC" box is ticked
MAIL_CC_ADDRESS=digispireacademy@gmail.com

# Sending limits. Ask your host for the hourly cap; most cPanel hosts count
# every To/BCC recipient toward it.
MAIL_BCC_CHUNK_SIZE=50
MAIL_MAX_PER_HOUR=100
MAIL_SEND_DELAY_MS=1000
MAIL_MAX_ATTEMPTS=5

# Test mode is ON unless set to false: every email goes only to
# MAIL_TEST_RECIPIENT (with a banner listing the real recipients).
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=you@yourdomain.com
# In test mode, a monthly run sends only this many sample reports.
MAIL_TEST_SAMPLE_SIZE=3

# Monthly report: last day of each month at this time (24h, APP_TIMEZONE).
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_TIME=20:00
APP_TIMEZONE=Asia/Kolkata

# Branding used in the email templates
ACADEMY_NAME=DIGISPIRE
APP_BASE_URL=https://digispire.vercel.app
ACADEMY_LOGO_URL=https://digispire.vercel.app/logo.png

# Protects /api/email-cron. Any long random string (Vercel Cron sends it automatically).
CRON_SECRET=





