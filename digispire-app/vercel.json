{
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/email-cron", "schedule": "0 15 * * *" }
  ],
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/((?!api/|assets/|privacy-policy|privacy|logo.png|favicon).*)", "destination": "/index.html" }
  ]
}
