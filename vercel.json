{
  "installCommand": "cd digispire-app && npm install",
  "buildCommand": "cd digispire-app && npm run build",
  "outputDirectory": "digispire-app/dist",
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/((?!assets/|privacy-policy|privacy|logo.png|favicon).*)", "destination": "/index.html" }
  ]
}
